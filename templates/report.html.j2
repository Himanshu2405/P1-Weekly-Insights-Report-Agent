{#- Weekly report page. Section order and components come from report_layout.yaml. -#}
{%- set tick = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8.5l3 3 7-7"/></svg>' -%}
{%- set cross = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4l8 8M12 4l-8 8"/></svg>' -%}
{%- set icons = {
  "serious": '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 2l6.5 11.5h-13z"/><path d="M8 6.5v3M8 11.5v.01"/></svg>',
  "warning": '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="8" cy="8" r="6"/><path d="M8 5v3.5M8 11v.01"/></svg>'} -%}
{%- set arrows = {"up": '<svg width="10" height="10" viewBox="0 0 10 10"><path d="M5 1l4 6H1z" fill="currentColor"/></svg>',
                  "down": '<svg width="10" height="10" viewBox="0 0 10 10"><path d="M5 9L1 3h8z" fill="currentColor"/></svg>', "flat": ""} -%}

{%- macro commentary(slot) -%}
  <div class="ai pending">
    <div class="tag">AI commentary · slot "{{ slot }}"</div>
    <p>Commentary will be generated here in Phase 2 (points with a "So what", checked by guards before publishing).</p>
  </div>
{%- endmacro -%}

{%- macro chart(comp, size="") -%}
  <div class="card"><p class="ctitle">{{ comp.title }}</p>
    {%- if comp.note %}<p class="csub">{{ comp.note }}</p>{% endif %}
    <div class="chart {{ size }}" data-chart="{{ comp._id }}"></div></div>
{%- endmacro -%}

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title }}</title>
<script src="https://cdn.jsdelivr.net/npm/plotly.js-dist-min@2.35.2/plotly.min.js"></script>
<style>
{% include "report.css" %}
</style>
</head>
<body>
<div class="wrap">
{%- for section in layout.sections %}
{%- set comps = section.components %}

{%- if section.id == "header" %}
<header class="top">
  <div><h1>{{ page_title }}</h1><div class="sub">{{ week_label }}</div></div>
  <div class="meta">
    {%- if quality.all_passed %}
    <span class="chip ok">{{ tick|safe }}Data checks passed: {{ quality.checks|length }} of {{ quality.checks|length }}</span>
    {%- else %}
    <span class="chip fail">{{ cross|safe }}Data checks failed</span>
    {%- endif %}
    <span class="chip pending">AI commentary: not enabled yet</span>
    <span class="chip">{{ published }}</span>
    <span class="chip">{{ data_through }}</span>
  </div>
</header>

{%- elif section.id == "archive" %}
<section><h2>{{ section.title }}</h2>
  <div class="archive">
  {%- for a in archive %}<a class="chip" href="{{ a.href }}">{{ a.label }}</a>{% else %}<span class="chip">No earlier reports yet</span>{% endfor %}
  </div>
</section>

{%- else %}
<section{% if section.id == "trust" %} class="trust"{% endif %}>
  <h2>{{ section.title }}</h2>
  {%- if section.subtitle %}<p class="lead">{{ section.subtitle }}</p>{% endif %}

  {%- for comp in comps %}
    {%- if comp.type == "tiles" %}
  <div class="grid g3">
    {%- for t in tiles %}
    <div class="card tile"><div class="label">{{ t.label }}</div><div class="big">{{ "%.1f"|format(t.pct) }}%</div>
      <div class="small">{{ t.detail }}</div>
      <div class="bar" title="100% = on plan"><span style="width:{{ [t.pct, 300]|min / 3 }}%"></span><i style="left:33.3%"></i></div>
      <div class="small" style="margin-top:4px;color:var(--muted)">Marker = 100% of plan (bar scale 0 to 300%)</div>
      <div class="small" style="margin-top:8px">{{ t.next }}</div></div>
    {%- endfor %}
  </div>

    {%- elif comp.type == "watchouts" %}
  <div class="grid g2">
    {%- for w in watchouts %}
    <div class="card watch"><div class="ico" style="background:color-mix(in srgb, var(--{{ w.severity }}) 22%, transparent);color:var(--{{ w.severity }})">{{ icons[w.severity]|safe }}</div>
      <div><div class="lbl">{{ w.label }}</div><div>{{ w.text }}</div><div class="src">{{ w.source }}</div></div></div>
    {%- endfor %}
  </div>

    {%- elif comp.type == "kpi_cards" %}
  <div class="grid g3">
    {%- for c in kpi_cards %}
    <div class="card kpi"><div class="name">{{ c.name }}</div>
      <div class="row"><div><div class="val">{{ c.value }}</div>
        {%- for text, assess, dir in c.deltas %}
        <div><span class="delta {{ assess }}">{{ arrows[dir]|safe }}{{ text }}</span></div>
        {%- endfor %}
      </div>{{ c.spark|safe }}</div>
      <div class="foot">{{ c.foot }}</div></div>
    {%- endfor %}
  </div>

    {%- elif comp.type in ["line_chart", "cumulative_chart", "waterfall", "bar_chart"] %}
      {%- if loop.first or comps[loop.index0 - 1].type not in ["line_chart", "cumulative_chart", "waterfall", "bar_chart"] or comp.type in ["cumulative_chart", "bar_chart"] %}
        {%- if not loop.first %}</div>{% endif %}
  <div class="grid {{ 'g2' if comp.type in ['line_chart', 'waterfall'] else '' }}" style="margin-top:14px">
      {%- endif %}
    {{ chart(comp, "sm" if (comp.weeks or 52) <= 26 or comp.type == "cumulative_chart" else "") }}
      {%- if loop.last %}</div>{% endif %}

    {%- elif comp.type == "table" %}
  <details{% if not comp.collapsed %} open{% endif %}><summary>{{ "Region" if comp.cut == "region" else "Traffic source" }} breakdown</summary>
    <div class="tablewrap"><table>
      <thead><tr><th>Segment</th><th>Orders</th><th>Orders WoW</th><th>Orders YoY</th><th>Revenue</th><th>Revenue WoW</th><th>Revenue YoY</th><th>Share of orders</th><th>Contribution to WoW change</th></tr></thead>
      <tbody>
      {%- for r in tables[comp.cut] %}
      <tr{% if r.total %} style="font-weight:600"{% endif %}><td>{{ r.segment }}</td><td>{{ r.orders }}</td><td>{{ r.orders_wow }}</td><td>{{ r.orders_yoy }}</td><td>{{ r.revenue }}</td><td>{{ r.revenue_wow }}</td><td>{{ r.revenue_yoy }}</td><td>{{ r.share }}</td><td>{{ r.contribution }}</td></tr>
      {%- endfor %}
      </tbody></table></div>
  </details>

    {%- elif comp.type == "trust_panel" %}
  <div class="grid g2">
    <div class="card"><p class="ctitle">Data-quality checks this run</p>
      <ul class="checks">
      {%- for c in quality.checks %}
        <li>{{ (tick if c.passed else cross)|safe }}<span>{{ c.name|replace("_", " ")|capitalize }}</span><span class="n">{{ "pass" if c.passed else "FAIL" }}</span></li>
      {%- endfor %}
      </ul>
      <p class="csub" style="margin-top:10px">AI commentary checks (numbers, direction words, banned claims) arrive in Phase 2.</p>
    </div>
    <div class="card"><p class="ctitle">Run details</p>
      <dl>
        <dt>Run ID</dt><dd>{{ run.run_id }}</dd>
        <dt>BigQuery scanned</dt><dd>{{ run.bytes }}</dd>
        <dt>Plan version</dt><dd>{{ run.target_version }}</dd>
        <dt>Brief / layout</dt><dd>v{{ run.brief_version }} / v{{ run.layout_version }}</dd>
        <dt>Model</dt><dd>not used yet (Phase 2)</dd>
        <dt>LLM cost</dt><dd>$0.00</dd>
      </dl>
    </div>
  </div>
  <details><summary>KPI definitions and data notes</summary>
    <ul style="margin:10px 0 0; padding-left:20px; font-size:14px; color:var(--ink-2)">
      <li><b>Weekly Orders Placed</b>: orders created Monday to Sunday (UTC), any status.</li>
      <li><b>Weekly Gross Revenue (excl. cancelled)</b>: value of non-cancelled items in orders placed that week. Returns are not subtracted.</li>
      <li><b>Weekly Average Order Value</b>: Gross Revenue divided by non-cancelled orders.</li>
      <li><b>Weekly Order Cancellation Rate</b>: cancelled orders as a share of orders placed.</li>
      <li><b>14-Day Return Rate</b>: orders the customer returned within 14 days of ordering. Reported only for weeks where every order has had 14 days.</li>
      <li><b>Weekly New Customer Signups</b>: new customer accounts created in the week.</li>
      <li><b>Targets</b>: 2026 annual plan, same week last year plus 75% growth, frozen at the start of the year.</li>
      <li><b>Source</b>: BigQuery public dataset thelook_ecommerce (a fictional store). The source is regenerated daily, so past weeks can shift slightly between runs.</li>
    </ul>
  </details>
    {%- endif %}
  {%- endfor %}

  {%- if section.commentary %}{{ commentary(section.commentary) }}{% endif %}
</section>
{%- endif %}
{%- endfor %}

<footer>{{ page_title }}. Portfolio project: automated weekly report with evaluated, traced, and guarded AI commentary.</footer>
</div>

<script>
const CHARTS = {{ charts_json|safe }};
const FORMATS = {{ kpi_formats_json|safe }};
const css = k => getComputedStyle(document.documentElement).getPropertyValue(k).trim();
const cfg = {displayModeBar: false, responsive: true};
const fmtFor = unit => ({count: {p: '', f: ',.0f', s: ''}, usd: {p: '$', f: ',.0f', s: ''}, usd_cents: {p: '$', f: ',.2f', s: ''},
                         percent: {p: '', f: '.1f', s: '%'}})[FORMATS[unit] || 'count'];

function base(extra = {}) {
  return Object.assign({
    paper_bgcolor: 'rgba(0,0,0,0)', plot_bgcolor: 'rgba(0,0,0,0)',
    font: {family: '-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif', size: 12, color: css('--ink-2')},
    margin: {l: 56, r: 12, t: 24, b: 36},
    xaxis: {gridcolor: 'rgba(0,0,0,0)', linecolor: css('--axis'), tickfont: {color: css('--muted')}, fixedrange: true},
    yaxis: {gridcolor: css('--grid'), zeroline: false, tickfont: {color: css('--muted')}, fixedrange: true},
    hovermode: 'x unified', hoverlabel: {bgcolor: css('--surface'), bordercolor: css('--axis'), font: {color: css('--ink')}},
    legend: {orientation: 'h', y: 1.15, x: 0, font: {color: css('--ink-2')}},
  }, extra);
}

const STYLE = {
  actual:    () => ({color: css('--s1'), width: 2}),
  reference: () => ({color: css('--muted'), width: 2, dash: 'dash'}),
  target:    () => ({color: css('--muted'), width: 2, dash: 'dash'}),
  future:    () => ({color: css('--muted'), width: 2, dash: 'dot'}),
};

function line(el, c) {
  const f = fmtFor(c.unit);
  const traces = c.series.map(s => ({
    x: c.x, y: s.y, name: s.name, type: 'scatter', mode: s.markers ? 'lines+markers' : 'lines', connectgaps: false,
    line: STYLE[s.role](), marker: {size: 8, color: css('--s1'), line: {color: css('--surface'), width: 2}},
    hovertemplate: f.p + '%{y:' + f.f + '}' + f.s,
  }));
  const layout = base({yaxis: Object.assign(base().yaxis, {tickprefix: f.p, ticksuffix: f.s, tickformat: f.s ? '' : '~s'})});
  if (c.today) {
    layout.shapes = [{type: 'line', x0: c.today, x1: c.today, yref: 'paper', y0: 0, y1: 1, line: {color: css('--axis'), width: 1}}];
    layout.annotations = [{x: c.today, y: 1, yref: 'paper', text: 'Today', showarrow: false, xanchor: 'left', yanchor: 'top',
                           font: {size: 11, color: css('--muted')}}];
  }
  Plotly.react(el, traces, layout, cfg);
}

function waterfall(el, c) {
  const n0 = v => Math.round(v).toLocaleString('en-US');
  Plotly.react(el, [{
    type: 'waterfall', x: ['Prior week', ...c.labels, 'Reporting week'],
    measure: ['absolute', ...c.labels.map(() => 'relative'), 'total'],
    y: [c.prior_total, ...c.deltas, 0],
    text: [n0(c.prior_total), ...c.deltas.map(v => (v > 0 ? '+' : '') + n0(v)), n0(c.now_total)],
    textposition: 'outside', textfont: {color: css('--ink-2')}, cliponaxis: false,
    connector: {line: {color: css('--axis'), width: 1}},
    increasing: {marker: {color: css('--s1')}}, decreasing: {marker: {color: '#e34948'}}, totals: {marker: {color: css('--muted')}},
    hovertemplate: '%{x}: %{text}<extra></extra>',
  }], base({showlegend: false, hovermode: 'closest', margin: {l: 56, r: 12, t: 28, b: 60}}), cfg);
}

function bar(el, c) {
  Plotly.react(el, [{
    type: 'bar', orientation: 'h', y: c.labels, x: c.values, marker: {color: css('--s1'), cornerradius: 4},
    text: c.values.map(v => v == null ? 'n/a' : (v > 0 ? '+' : '') + v.toFixed(1) + '%'), textposition: 'outside',
    textfont: {color: css('--ink-2')}, cliponaxis: false, hovertemplate: '%{y}: %{text}<extra></extra>',
  }], base({
    showlegend: false, hovermode: 'closest', margin: {l: 150, r: 56, t: 16, b: 32},
    yaxis: {autorange: 'reversed', tickfont: {color: css('--ink-2')}, fixedrange: true},
    xaxis: {gridcolor: css('--grid'), ticksuffix: '%', tickfont: {color: css('--muted')}, zeroline: false, fixedrange: true},
    shapes: [{type: 'line', x0: c.reference, x1: c.reference, yref: 'paper', y0: 0, y1: 1, line: {color: css('--muted'), width: 2, dash: 'dash'}}],
    annotations: [{x: c.reference, y: 1.04, yref: 'paper', text: 'Plan +' + c.reference + '%', showarrow: false, xanchor: 'left',
                   font: {size: 11, color: css('--muted')}}],
  }), cfg);
}

const RENDER = {line, waterfall, bar};
function renderAll() {
  document.querySelectorAll('[data-chart]').forEach(el => {
    const c = CHARTS[el.dataset.chart];
    if (c) RENDER[c.type](el, c);
  });
}
renderAll();
matchMedia('(prefers-color-scheme: dark)').addEventListener('change', renderAll);
</script>
</body>
</html>
